{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestats.local/contracts/event.schema.json",
  "title": "GameStatsEvent",
  "type": "object",
  "required": ["schemaVersion", "eventId", "timestamp", "gameId", "gameVersion", "matchId", "type"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "eventId": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "gameId": { "type": "string", "minLength": 1 },
    "gameVersion": { "type": "string", "minLength": 1 },
    "matchId": { "type": "string", "minLength": 1 },
    "playerId": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["MATCH_STARTED", "MATCH_FINISHED", "PLAYER_JOINED", "PLAYER_LEFT", "GAME_ACTION"]
    },
    "action": { "type": "string", "minLength": 1 },
    "data": { "type": "object", "default": {} }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "GAME_ACTION" } } },
      "then": { "required": ["action", "playerId"] }
    },
    {
      "if": { "properties": { "type": { "enum": ["PLAYER_JOINED", "PLAYER_LEFT"] } } },
      "then": { "required": ["playerId"] }
    }
  ]
}
